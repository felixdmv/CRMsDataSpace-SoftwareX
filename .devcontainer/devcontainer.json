{
  "name": "CRMsDataSpace SoftwareX Demonstrator",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "CRMsDataSpace Web Application",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install -r SoftwareX/code/requirements.txt || true",
  "postStartCommand": "python run_app.py --port 8080 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
