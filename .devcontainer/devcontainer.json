{
  "name": "CRMsDataSpace & GIS Architecture Template (SoftwareX)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8080, 8085],
  "portsAttributes": {
    "8080": {
      "label": "CRMsDataSpace Web Application (European CRMs)",
      "onAutoForward": "openPreview",
      "elevateIfNeeded": false
    },
    "8085": {
      "label": "General GIS Architecture Template Sandbox",
      "onAutoForward": "openPreview",
      "elevateIfNeeded": false
    }
  },
  "postCreateCommand": "pip install -r code/requirements.txt || true",
  "postAttachCommand": "python run_codespace.py",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
