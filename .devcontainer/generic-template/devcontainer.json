{
  "name": "General-Purpose GIS Architecture Template (Customizable Sandbox)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8085],
  "portsAttributes": {
    "8085": {
      "label": "GIS Architecture Template Sandbox",
      "onAutoForward": "openPreview",
      "elevateIfNeeded": false
    }
  },
  "postCreateCommand": "echo 'General GIS Architecture Template ready (zero external dependencies)'",
  "postAttachCommand": "python run_template.py --port 8085",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
