  "conversational_memory": [
    {
      "episode_id": "EP-RREDONDO-01",
      "title": "Iberian Corridor with 'y también...' expansion, progressive refinement and reset",
      "turns": [
        {
          "turn": 1,
          "query": "Muestra escombreras en España",
          "expected_action": "new_search",
          "expected_filters": {
            "countries": [
              "spain"
            ],
            "storage_facility_types": [
              "waste dump"
            ],
            "commodities": [],
            "project_status": []
          },
          "expected_count": 3,
          "description": "Initial search establishing Spain and waste dump."
        },
        {
          "turn": 2,
          "query": "y también en Portugal",
          "expected_action": "expand",
          "expected_filters": {
            "countries": [
              "spain",
              "portugal"
            ],
            "storage_facility_types": [
              "waste dump"
            ],
            "commodities": [],
            "project_status": []
          },
          "expected_count": 5,
          "description": "'y también...' expands country to Spain + Portugal (sum of escombreras: 3 + 2 = 5) while retaining waste dump."
        },
        {
          "turn": 3,
          "query": "y de esas solo las que tienen wolframio",
          "expected_action": "refine",
          "expected_filters": {
            "countries": [
              "spain",
              "portugal"
            ],
            "storage_facility_types": [
              "waste dump"
            ],
            "commodities": [
              "tungsten"
            ],
            "project_status": []
          },
          "expected_count": 2,
          "description": "Refines accumulated Iberian waste dumps to those containing tungsten (EU-CRM-017, EU-CRM-004)."
        },
        {
          "turn": 4,
          "query": "de esas, únicamente las que están en desarrollo",
          "expected_action": "refine",
          "expected_filters": {
            "countries": [
              "spain",
              "portugal"
            ],
            "storage_facility_types": [
              "waste dump"
            ],
            "commodities": [
              "tungsten"
            ],
            "project_status": [
              "development"
            ]
          },
          "expected_count": 2,
          "description": "Progressively narrows down by status while preserving all prior context."
        },
        {
          "turn": 5,
          "query": "ahora quita Portugal",
          "expected_action": "remove",
          "expected_filters": {
            "countries": [
              "spain"
            ],
            "storage_facility_types": [
              "waste dump"
            ],
            "commodities": [
              "tungsten"
            ],
            "project_status": [
              "development"
            ]
          },
          "expected_count": 1,
          "description": "Removes Portugal while preserving Spain, waste dump, tungsten, and development status."
        },
        {
          "turn": 6,
          "query": "reiniciar búsqueda",
          "expected_action": "reset",
          "expected_filters": {
            "countries": [],
            "storage_facility_types": [],
            "commodities": [],
            "project_status": []
          },
          "expected_count": 100,
          "description": "Resets entire conversation memory back to full 100-site dataset."
        }
      ]
    },
